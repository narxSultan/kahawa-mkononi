generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  ADMIN
  MANAGER
  STAFF
  CALL_CENTRE_AGENT
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum CentreStatus {
  ACTIVE
  SUSPENDED
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

enum OrderStatus {
  PENDING
  STAFF_COMPLETED
  CUSTOMER_REJECTED
  COMPLETED
  CANCELLED
}

enum NotificationType {
  INFO
  WARNING
  TASK
  SYSTEM
}

enum DutyPriority {
  LOW
  MEDIUM
  HIGH
}

enum DutyStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum HandoverStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model Role {
  id          String   @id @default(cuid())
  name        RoleName @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  phone        String?
  username     String?    @unique
  fullName     String
  passwordHash String
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  profilePhoto String?
  address      String?
  deletedAt    DateTime?

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  serviceCentreId String?
  serviceCentre   ServiceCentre? @relation(fields: [serviceCentreId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockMovements StockMovement[] @relation("StockMovementCreatedBy")
  sales          Sale[]          @relation("SaleCreatedBy")

  sentNotifications     Notification[] @relation("NotificationSender")
  receivedNotifications Notification[] @relation("NotificationReceiver")
  assignedDuties        Duty[]         @relation("DutyAssignedTo")
  createdDuties         Duty[]         @relation("DutyAssignedBy")
  dutyComments          DutyComment[]
  createdHandovers      Handover[]     @relation("HandoverManager")
  assignedHandovers     Handover[]     @relation("HandoverAssignedStaff")
  activityLogs          ActivityLog[]

  customerProfile      Customer? @relation("CustomerUser")
  staffCompletedOrders Order[]   @relation("OrderStaffCompletedBy")
  staffRespondedOrders Order[]   @relation("OrderStaffResponseBy")
  staffMessagedOrders  Order[]   @relation("OrderStaffMessageBy")
  transferredOrders    Order[]   @relation("OrderTransferredBy")
}

model Customer {
  id           String   @id @default(cuid())
  fullName     String
  phone        String   @unique
  email        String?
  address      String?
  customerType String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sales Sale[]

  userId String? @unique
  user   User?   @relation("CustomerUser", fields: [userId], references: [id])

  orders Order[]

  feedback Feedback[]
}

model Product {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  price       Decimal  @db.Decimal(12, 2)
  currency    String   @default("TZS")
  isActive    Boolean  @default(true)
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems OrderItem[]
}

model Order {
  id         String      @id @default(cuid())
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id])
  status     OrderStatus @default(PENDING)

  serviceCentreId String?
  serviceCentre   ServiceCentre? @relation("OrderServiceCentre", fields: [serviceCentreId], references: [id])

  transferredAt DateTime?
  transferredByUserId String?
  transferredByUser   User?     @relation("OrderTransferredBy", fields: [transferredByUserId], references: [id])
  transferredFromServiceCentreId String?
  transferredFromServiceCentre   ServiceCentre? @relation("OrderTransferredFromCentre", fields: [transferredFromServiceCentreId], references: [id])
  transferredToServiceCentreId String?
  transferredToServiceCentre   ServiceCentre? @relation("OrderTransferredToCentre", fields: [transferredToServiceCentreId], references: [id])

  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  staffCompletedAt       DateTime?
  staffCompletedByUserId String?
  staffCompletedByUser   User?     @relation("OrderStaffCompletedBy", fields: [staffCompletedByUserId], references: [id])

  customerAcknowledgedAt DateTime?
  customerRejectedAt      DateTime?
  customerRejectionReason String?

  staffResponseAt       DateTime?
  staffResponseByUserId String?
  staffResponseByUser   User?    @relation("OrderStaffResponseBy", fields: [staffResponseByUserId], references: [id])
  staffResponseMessage  String?

  staffMessageAt       DateTime?
  staffMessageByUserId String?
  staffMessageByUser   User?    @relation("OrderStaffMessageBy", fields: [staffMessageByUserId], references: [id])
  staffMessageText     String?

  customerMessageAt   DateTime?
  customerMessageText String?

  items OrderItem[]

  feedback Feedback[]

  @@index([status, createdAt])
  @@index([customerId, createdAt])
  @@index([serviceCentreId, status])
}

model Feedback {
  id String @id @default(cuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  orderId String?
  order   Order? @relation(fields: [orderId], references: [id])

  rating  Int
  comment String?

  createdAt DateTime @default(now())

  @@index([customerId, createdAt])
  @@index([orderId])
}

model SystemSetting {
  id    String  @id @default(cuid())
  key   String  @unique
  value String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity  Int     @default(1)
  unitPrice Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([orderId])
}

model ServiceCentre {
  id           String       @id @default(cuid())
  centreName   String
  phone        String?
  managerName  String?
  status       CentreStatus @default(ACTIVE)
  locationName String?
  address      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  sales          Sale[]
  stockItems     StockItem[]
  stockMovements StockMovement[]
  notifications  Notification[]
  duties         Duty[]
  handovers      Handover[]
  orders         Order[]         @relation("OrderServiceCentre")
  transferredFromOrders Order[]  @relation("OrderTransferredFromCentre")
  transferredToOrders   Order[]  @relation("OrderTransferredToCentre")
}

model Service {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sales Sale[]
}

model Sale {
  id              String        @id @default(cuid())
  serviceCentreId String
  serviceCentre   ServiceCentre @relation(fields: [serviceCentreId], references: [id])

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  serviceId     String?
  service       Service? @relation(fields: [serviceId], references: [id])
  serviceCustom String?

  cupsSold         Int     @default(0)
  takeawayCupsUsed Int     @default(0)
  amount           Decimal @db.Decimal(12, 2)
  currency         String  @default("TZS")

  staffUserId String?
  staffUser   User?   @relation("SaleCreatedBy", fields: [staffUserId], references: [id])

  happenedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([serviceCentreId, happenedAt])
}

model StockItem {
  id              String        @id @default(cuid())
  serviceCentreId String
  serviceCentre   ServiceCentre @relation(fields: [serviceCentreId], references: [id])

  name              String
  unit              String  @default("unit")
  lowStockThreshold Int     @default(0)
  isActive          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements StockMovement[]

  @@unique([serviceCentreId, name])
}

model StockMovement {
  id              String        @id @default(cuid())
  serviceCentreId String
  serviceCentre   ServiceCentre @relation(fields: [serviceCentreId], references: [id])

  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id])

  type     StockMovementType
  quantity Int
  note     String?

  createdByUserId String?
  createdByUser   User?   @relation("StockMovementCreatedBy", fields: [createdByUserId], references: [id])

  happenedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([serviceCentreId, happenedAt])
  @@index([stockItemId, happenedAt])
}

model Notification {
  id      String           @id @default(cuid())
  title   String
  message String
  type    NotificationType @default(INFO)
  isRead  Boolean          @default(false)

  senderId String?
  sender   User?   @relation("NotificationSender", fields: [senderId], references: [id])

  receiverId String?
  receiver   User?   @relation("NotificationReceiver", fields: [receiverId], references: [id])

  serviceCentreId String?
  serviceCentre   ServiceCentre? @relation(fields: [serviceCentreId], references: [id])

  targetRole RoleName?

  createdAt DateTime @default(now())

  @@index([receiverId, isRead, createdAt])
  @@index([serviceCentreId, createdAt])
  @@index([targetRole, createdAt])
}

model Duty {
  id          String       @id @default(cuid())
  title       String
  description String?
  priority    DutyPriority @default(MEDIUM)
  status      DutyStatus   @default(PENDING)
  startDate   DateTime?
  dueDate     DateTime?

  assignedToUserId String
  assignedToUser   User   @relation("DutyAssignedTo", fields: [assignedToUserId], references: [id])

  assignedByUserId String
  assignedByUser   User   @relation("DutyAssignedBy", fields: [assignedByUserId], references: [id])

  serviceCentreId String
  serviceCentre   ServiceCentre @relation(fields: [serviceCentreId], references: [id])

  comments DutyComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceCentreId, status, createdAt])
  @@index([assignedToUserId, status, dueDate])
}

model DutyComment {
  id        String   @id @default(cuid())
  dutyId    String
  duty      Duty     @relation(fields: [dutyId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  message   String
  createdAt DateTime @default(now())

  @@index([dutyId, createdAt])
}

model Handover {
  id              String        @id @default(cuid())
  managerId       String
  manager         User          @relation("HandoverManager", fields: [managerId], references: [id])
  assignedStaffId String
  assignedStaff   User          @relation("HandoverAssignedStaff", fields: [assignedStaffId], references: [id])
  serviceCentreId String
  serviceCentre   ServiceCentre @relation(fields: [serviceCentreId], references: [id])

  reason    String?
  notes     String?
  startDate DateTime
  endDate   DateTime
  status    HandoverStatus @default(ACTIVE)

  permissions HandoverPermission[]

  createdAt DateTime @default(now())

  @@index([managerId, status])
  @@index([assignedStaffId, status])
  @@index([serviceCentreId, status])
}

model HandoverPermission {
  id         String   @id @default(cuid())
  handoverId String
  handover   Handover @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  code       String

  @@unique([handoverId, code])
  @@index([code])
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  action      String
  module      String
  description String
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([module, createdAt])
  @@index([userId, createdAt])
}
